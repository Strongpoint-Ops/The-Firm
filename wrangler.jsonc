{
  // The Strongpoint Firm — strongpointops.com.
  //
  // Static assets PLUS a small Worker, because the contact forms post real
  // leads now. worker/index.js serves /api/lead and /api/version and hands
  // everything else to the ASSETS binding.
  //
  // ⚠ "name" MUST match the Worker name in the Cloudflare dashboard or the
  // build fails with no useful error. The dashboard Worker is called
  // "strongpoint-firm" — the apex and main. are both bound to it — so that
  // is the name here, not the repo name.
  //
  // Deploy command is a DASHBOARD setting: use `npx wrangler deploy`, never a
  // bare `wrangler deploy`.
  //
  // One-time setup for leads:
  //   npx wrangler d1 create strongpoint-leads     (paste database_id below)
  //   npx wrangler d1 execute strongpoint-leads --remote --file schema.sql
  //   npx wrangler secret put RESEND_API_KEY
  // Until the secret exists, leads are stored but not emailed. /api/version
  // reports which of the two are wired up.
  "name": "strongpoint-firm",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Uncomment once the database exists. A placeholder database_id FAILS the
  // build, which would take the whole site down with it — so this stays
  // commented until `d1 create` has handed you a real id.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "strongpoint-leads",
  //     "database_id": "<id from: npx wrangler d1 create strongpoint-leads>"
  //   }
  // ],
  "vars": {
    "LEAD_TO": "info@strongpointops.com",
    "LEAD_FROM": "Strongpoint leads <leads@strongpointops.com>"
  }
}
